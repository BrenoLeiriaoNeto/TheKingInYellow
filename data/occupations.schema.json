{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OccupationsSchema",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "name", "creditRatingMin", "creditRatingMax", "formula", "skillIds"],
    "properties": {
      "id": { "type": "string" },
      "name": { "type": "string" },
      "description": { "type": "string" },
      "creditRatingMin": { "type": "integer", "minimum": 0, "maximum": 99 },
      "creditRatingMax": { "type": "integer", "minimum": 0, "maximum": 99 },
      "formula": {
        "type": "object",
        "required": ["primaryAttr", "primaryMultiplier"],
        "properties": {
          "primaryAttr": { "type": "string", "enum": ["EDU", "STR", "DEX", "INT", "POW", "APP", "CON", "SIZ"] },
          "primaryMultiplier": { "type": "integer" },
          "secondaryChoiceAttrs": {
            "type": "array",
            "items": { "type": "string", "enum": ["EDU", "STR", "DEX", "INT", "POW", "APP", "CON", "SIZ"] }
          },
          "secondaryMultiplier": { "type": "integer" }
        }
      },
      "skillIds": {
        "type": "array",
        "items": { "type": "string" },
        "minItems": 8,
        "maxItems": 8
      },
      "suggestedContacts": {
        "type": "array",
        "items": { "type": "string" }
      }
    }
  }
}